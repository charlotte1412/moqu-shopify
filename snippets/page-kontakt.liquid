<div class="page-header">
  <h1 class="page-title reveal">Kontakt</h1>
  <p class="page-lead reveal reveal-d1">
    Erzähl uns von deinem Projekt. Wir antworten innerhalb eines Werktags.
  </p>
</div>

<section class="contact-section reveal">
  <p class="contact-heading">Projektidee?<br>Kontaktiere uns.</p>

  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <div style="display:block; margin-bottom:24px; padding:14px 18px; border-radius:6px; font-size:15px; background:rgba(46,138,77,0.1); color:#2e8a4d; border:1px solid rgba(46,138,77,0.3);">Danke! Wir melden uns zeitnah bei dir.</div>
    {%- endif -%}
    {%- if form.errors -%}
      <div style="display:block; margin-bottom:24px; padding:14px 18px; border-radius:6px; font-size:15px; background:rgba(201,59,26,0.08); color:#c93b1a; border:1px solid rgba(201,59,26,0.3);">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="radio-group">
      <label class="radio-label"><input type="radio" name="contact[Kundentyp]" value="Privatkunde" checked />Privatkunde</label>
      <label class="radio-label"><input type="radio" name="contact[Kundentyp]" value="Gewerblicher Kunde" />Gewerblicher Kunde</label>
    </div>

    <div class="form-grid">
      <div class="form-field"><label class="form-label">Vorname</label><input type="text" name="contact[Vorname]" class="form-input" required /></div>
      <div class="form-field"><label class="form-label">Nachname</label><input type="text" name="contact[Nachname]" class="form-input" required /></div>
      <div class="form-field full"><label class="form-label">E-Mail</label><input type="email" name="contact[email]" class="form-input" required /></div>
      <div class="form-field"><label class="form-label">Telefonnummer</label><input type="tel" name="contact[phone]" class="form-input" /></div>
      <div class="form-field"><label class="form-label">Anschrift</label><input type="text" name="contact[Anschrift]" class="form-input" /></div>
      <div class="form-field"><label class="form-label">Gewünschter Einbautermin</label><input type="text" name="contact[Einbautermin]" class="form-input" /></div>
      <div class="form-field"><label class="form-label">Kategorie</label>
        <select name="contact[Kategorie]" class="form-select">
          <option value="">Auswählen...</option>
          <option>Einbauschrank</option><option>Küche</option><option>Wandverkleidung</option>
          <option>Möbel nach Maß</option><option>Innenausbau</option><option>Sonstiges</option>
        </select>
      </div>
      <div class="form-field full" style="margin-top:8px;"><label class="form-label">Nachricht</label><textarea name="contact[body]" class="form-textarea" rows="4"></textarea></div>
    </div>

    <div class="form-consent">
      <input type="checkbox" id="consent" name="contact[Einverstanden]" required />
      <label for="consent">Ich stimme zu, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert und verwendet werden. Weitere Informationen findest du in unserer <a href="/pages/datenschutz">Datenschutzerklärung</a>.</label>
    </div>

    <button type="submit" class="btn-orange" style="margin-top:16px;">Abschicken &nbsp;→</button>
  {%- endform -%}
</section>

<style>
  .contact-heading { font-size: clamp(22px, 2.5vw, 30px); font-weight: 700; color: #1a1a18; margin-bottom: 40px; letter-spacing: -0.3px; line-height: 1.3; font-family: 'MuseoModerno',sans-serif; }
  .form-consent { display: flex; align-items: flex-start; gap: 12px; margin-top: 20px; }
  .form-consent input[type="checkbox"] { flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent,#c8772a); cursor: pointer; }
  .form-consent label { font-size: 14px; color: #5a5550; line-height: 1.55; cursor: pointer; }
  .form-consent label a { color: #1a1a18; text-decoration: underline; }
  .form-consent label a:hover { color: var(--accent,#c8772a); }
</style>
