<div class="alt-sections">
  {% for block in section.blocks %}
    {% assign odd = forloop.index0 | modulo: 2 %}
    <div class="alt-section{% if odd == 1 %} reverse{% endif %}" {{ block.shopify_attributes }}>
      <div class="alt-text">
        <div class="alt-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
        {% if block.settings.subtitle != blank %}
          <div class="alt-subtitle">{{ block.settings.subtitle }}</div>
        {% endif %}
        <h2 class="alt-heading">{{ block.settings.heading }}</h2>
        <div class="alt-body">{{ block.settings.body }}</div>
      </div>
      <div class="alt-img">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
        {% elsif block.settings.image_url != blank %}
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Alt-Sections",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "row",
      "name": "Bild/Text-Block",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (hochladen)" },
        { "type": "text", "id": "image_url", "label": "Bild-URL (Fallback)" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "heading", "label": "Überschrift" },
        { "type": "richtext", "id": "body", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Alt-Sections" }]
}
{% endschema %}
