<div class="page-header">
  <h1 class="page-title">{{ section.settings.title | default: page.title }}</h1>
  {% if section.settings.lead != blank %}
    <p class="page-lead">{{ section.settings.lead }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Seitenkopf",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel" },
    { "type": "textarea", "id": "lead", "label": "Lead-Text" }
  ],
  "presets": [{ "name": "Seitenkopf" }]
}
{% endschema %}
