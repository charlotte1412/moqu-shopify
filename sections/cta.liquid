<section class="cta">
  <div>
    {% if section.settings.label != blank %}
      <p class="cta-label">{{ section.settings.label }}</p>
    {% endif %}
    <h2 class="cta-title">{{ section.settings.title }}</h2>
  </div>
  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_url | default: '/pages/kontakt' }}" class="btn-orange">{{ section.settings.button_label }} &nbsp;→</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "CTA-Streifen",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow-Label" },
    { "type": "text", "id": "title", "label": "Überschrift" },
    { "type": "text", "id": "button_label", "label": "Button-Text" },
    { "type": "url", "id": "button_url", "label": "Button-Ziel" }
  ],
  "presets": [{ "name": "CTA-Streifen" }]
}
{% endschema %}
