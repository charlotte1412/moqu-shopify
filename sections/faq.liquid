<section class="faq-section">
  {% if section.settings.label != blank %}
    <p class="faq-label">{{ section.settings.label }}</p>
  {% endif %}
  <h2 class="faq-heading">{{ section.settings.heading | default: 'Häufige Fragen' }}</h2>
  <div class="faq-list">
    {% for block in section.blocks %}
      <div class="faq-item" {{ block.shopify_attributes }}>
        <button class="faq-q" type="button" aria-expanded="false">
          <span>{{ block.settings.question }}</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </button>
        <div class="faq-a">{{ block.settings.answer }}</div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow-Label", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Frage & Antwort",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage" },
        { "type": "richtext", "id": "answer", "label": "Antwort" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
