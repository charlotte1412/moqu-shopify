<section class="faq-section">
  {%- if section.settings.label != blank -%}
    <p class="faq-label reveal">{{ section.settings.label }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="faq-heading reveal">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="faq-list reveal">
    {%- for block in section.blocks -%}
      <div class="faq-item" {{ block.shopify_attributes }}>
        <button class="faq-q" type="button" aria-expanded="false">
          <span>{{ block.settings.question }}</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </button>
        <div class="faq-a">{{ block.settings.answer }}</div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- assign faq_json = '' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
    </script>
  {%- endif -%}
</section>

<style>
  .faq-section { background: #fcfbf7; padding: 20px 80px 100px; max-width: 900px; margin: 0 auto; }
  .faq-label { font-size: 11px; letter-spacing: 3.5px; color: var(--accent, #c8772a); text-transform: uppercase; margin-bottom: 16px; font-weight: 600; }
  .faq-heading { font-family: 'MuseoModerno', sans-serif; font-size: clamp(28px, 3.5vw, 40px); font-weight: 600; color: #1a1a18; letter-spacing: -0.5px; line-height: 1.15; margin-bottom: 40px; }
  .faq-list { display: flex; flex-direction: column; gap: 2px; }
  .faq-item { border-bottom: 1px solid rgba(0,0,0,0.08); }
  .faq-item:first-child { border-top: 1px solid rgba(0,0,0,0.08); }
  .faq-q { width: 100%; background: none; border: 0; padding: 22px 4px; display: flex; justify-content: space-between; align-items: center; gap: 20px; text-align: left; cursor: pointer; font-family: inherit; font-size: 16px; font-weight: 500; color: #1a1a18; transition: color 0.2s; }
  .faq-q:hover { color: var(--accent, #c8772a); }
  .faq-icon { width: 20px; height: 20px; stroke: currentColor; flex-shrink: 0; transition: transform 0.3s cubic-bezier(0.16,1,0.3,1); }
  .faq-q[aria-expanded="true"] .faq-icon { transform: rotate(45deg); }
  .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.16,1,0.3,1), padding 0.3s ease; font-size: 15.5px; color: #5a5550; line-height: 1.72; padding: 0 4px; }
  .faq-item.faq-open .faq-a { max-height: 500px; padding: 0 4px 22px; }
  @media (max-width: 1100px) { .faq-section { padding: 10px 40px 80px; } }
  @media (max-width: 760px)  { .faq-section { padding: 10px 24px 60px; } .faq-q { font-size: 15px; padding: 18px 4px; } .faq-a { font-size: 14.5px; } }
</style>

<script>
  (function(){
    document.querySelectorAll('.faq-section .faq-item').forEach(function(item){
      var btn = item.querySelector('.faq-q');
      if (!btn || btn.dataset.faqBound) return;
      btn.dataset.faqBound = '1';
      btn.addEventListener('click', function(){
        var open = item.classList.toggle('faq-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow-Label", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "faq",
      "name": "Frage & Antwort",
      "settings": [
        { "type": "text",     "id": "question", "label": "Frage" },
        { "type": "richtext", "id": "answer",   "label": "Antwort" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
