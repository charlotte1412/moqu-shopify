<div class="moqu-page-header">
  <h1 class="moqu-page-title">{{ section.settings.title | default: page.title }}</h1>
  {%- if section.settings.lead != blank -%}
    <p class="moqu-page-lead">{{ section.settings.lead }}</p>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "MOQU · Page Header",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel (leer = Seitentitel)" },
    { "type": "textarea", "id": "lead", "label": "Lead-Text" }
  ],
  "presets": [{ "name": "MOQU · Page Header" }]
}
{% endschema %}
