<section class="job-detail">
  <a href="/#stellenanzeigen" class="back-link">← Alle Stellen</a>
  <span class="job-badge">Stellenanzeige</span>
  <h1 class="job-detail-title">{{ section.settings.title | default: page.title }}</h1>

  <div class="job-meta">
    {% if section.settings.job_type != blank %}
      <span class="job-meta-item">{{ section.settings.job_type }}</span>
    {% endif %}
    {% if section.settings.location != blank %}
      <span class="job-meta-item">{{ section.settings.location }}</span>
    {% endif %}
  </div>

  {% if section.settings.intro != blank %}
    <p class="job-intro">{{ section.settings.intro }}</p>
  {% endif %}

  {% if section.settings.aufgaben != blank %}
    <div class="job-section">
      <h3 class="job-section-title">Deine Aufgaben</h3>
      <ul class="job-list-items">
        {% assign items = section.settings.aufgaben | newline_to_br | split: '<br />' %}
        {% for item in items %}
          {% assign trimmed = item | strip %}
          {% if trimmed != blank %}<li>{{ trimmed }}</li>{% endif %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if section.settings.profil != blank %}
    <div class="job-section">
      <h3 class="job-section-title">Dein Profil</h3>
      <ul class="job-list-items">
        {% assign items = section.settings.profil | newline_to_br | split: '<br />' %}
        {% for item in items %}
          {% assign trimmed = item | strip %}
          {% if trimmed != blank %}<li>{{ trimmed }}</li>{% endif %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if section.settings.angebot != blank %}
    <div class="job-section">
      <h3 class="job-section-title">Unser Angebot</h3>
      <ul class="job-list-items">
        {% assign items = section.settings.angebot | newline_to_br | split: '<br />' %}
        {% for item in items %}
          {% assign trimmed = item | strip %}
          {% if trimmed != blank %}<li>{{ trimmed }}</li>{% endif %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <div class="job-cta">
    <div class="job-cta-title">{{ section.settings.cta_title | default: 'Klingt interessant?' }}</div>
    <p class="job-cta-sub">{{ section.settings.cta_subtitle | default: 'Wir freuen uns auf deine Bewerbung.' }}</p>
    <a href="mailto:{{ section.settings.apply_email | default: 'info@moqu-interior.de' }}" class="btn-orange">{{ section.settings.cta_button | default: 'Jetzt bewerben' }} &nbsp;→</a>
  </div>
</section>

{% schema %}
{
  "name": "Stellen-Detail",
  "settings": [
    { "type": "text", "id": "title", "label": "Stellentitel" },
    { "type": "text", "id": "job_type", "label": "Beschäftigungsart", "default": "Vollzeit" },
    { "type": "text", "id": "location", "label": "Standort" },
    { "type": "textarea", "id": "intro", "label": "Einleitung" },
    { "type": "textarea", "id": "aufgaben", "label": "Aufgaben (ein Punkt pro Zeile)" },
    { "type": "textarea", "id": "profil", "label": "Profil (ein Punkt pro Zeile)" },
    { "type": "textarea", "id": "angebot", "label": "Angebot (ein Punkt pro Zeile)" },
    { "type": "text", "id": "cta_title", "label": "CTA-Überschrift" },
    { "type": "text", "id": "cta_subtitle", "label": "CTA-Untertitel" },
    { "type": "text", "id": "cta_button", "label": "Button-Text" },
    { "type": "text", "id": "apply_email", "label": "Bewerbungs-E-Mail" }
  ],
  "presets": [{ "name": "Stellen-Detail" }]
}
{% endschema %}
