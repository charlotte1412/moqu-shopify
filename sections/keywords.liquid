<div class="keywords-section">
  <div class="kw-icons-row">
    {% for block in section.blocks %}
      <a href="{{ block.settings.url | default: '#' }}" class="kw-icon-item kw-visible" {{ block.shopify_attributes }}>
        {% if block.settings.icon_svg != blank %}
          {{ block.settings.icon_svg }}
        {% else %}
          <svg viewBox="0 0 24 24"><circle pathLength="1" cx="12" cy="12" r="10"/></svg>
        {% endif %}
        <span class="kw-icon-label">{{ block.settings.label }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Keyword-Icons",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "keyword",
      "name": "Keyword",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Verlinktes Ziel" },
        { "type": "html", "id": "icon_svg", "label": "Icon (SVG-Code)" }
      ]
    }
  ],
  "presets": [{ "name": "Keyword-Icons" }]
}
{% endschema %}
