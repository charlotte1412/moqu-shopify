{%- assign rows = '' -%}
{%- assign row_group = '' -%}
{%- for block in section.blocks -%}
  {%- if block.settings.new_row and forloop.index > 1 -%}
    {%- assign rows = rows | append: row_group | append: '||' -%}
    {%- assign row_group = '' -%}
  {%- endif -%}
  {%- assign row_group = row_group | append: forloop.index0 | append: ',' -%}
{%- endfor -%}
{%- assign rows = rows | append: row_group -%}
{%- assign row_list = rows | split: '||' -%}

<section class="gallery">
  <div class="gallery-header">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.link_label != blank %}
      <a href="{{ section.settings.link_url | default: '/pages/projekte' }}" class="link-muted">{{ section.settings.link_label }} →</a>
    {% endif %}
  </div>
  <div class="gallery-rows">
    {% for row in row_list %}
      <div class="gallery-row">
        {%- assign block_idxs = row | split: ',' -%}
        {% for idx_str in block_idxs %}
          {%- if idx_str != blank -%}
            {%- assign idx = idx_str | plus: 0 -%}
            {%- assign block = section.blocks[idx] -%}
            <a class="gallery-item" href="{{ block.settings.url | default: '/pages/projekte' }}" style="flex: {{ block.settings.width | default: 1 }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 900 }}" width="900" height="600" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% elsif block.settings.image_url != blank %}
                <img src="{{ block.settings.image_url }}" width="900" height="600" alt="{{ block.settings.title | escape }}" loading="lazy">
              {% endif %}
              <div class="g-overlay"></div>
              <div class="g-caption"><span class="g-title">{{ block.settings.title }}</span></div>
            </a>
          {%- endif -%}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Galerie",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "text", "id": "link_label", "label": "Link-Text (rechts)" },
    { "type": "url", "id": "link_url", "label": "Link-Ziel" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Projekt-Kachel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (hochladen)" },
        { "type": "text", "id": "image_url", "label": "Bild-URL (Fallback)" },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "url", "id": "url", "label": "Verlinktes Ziel" },
        { "type": "range", "id": "width", "min": 1, "max": 5, "step": 1, "default": 2, "label": "Breite" },
        { "type": "checkbox", "id": "new_row", "label": "Neue Zeile ab hier", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Galerie" }]
}
{% endschema %}
