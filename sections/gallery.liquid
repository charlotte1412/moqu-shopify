<section class="gallery">
  <div class="gallery-header reveal">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url }}" class="link-muted">{{ section.settings.link_label }} →</a>
    {%- endif -%}
  </div>
  <div class="gallery-rows reveal">
    {%- assign rows = '' | split: '' -%}
    {%- assign current_row = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.new_row and forloop.index > 1 -%}</div><div class="gallery-row">{%- endif -%}
      {%- if forloop.first -%}<div class="gallery-row">{%- endif -%}
      <a class="gallery-item" href="{{ block.settings.url | default: '/pages/projekte' }}" style="flex: {{ block.settings.width | default: 1 }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
        {%- elsif block.settings.image_url != blank -%}
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'gallery-placeholder' }}
        {%- endif -%}
        <div class="g-overlay"></div>
        <div class="g-caption"><span class="g-cat">{{ block.settings.category }}</span><span class="g-title">{{ block.settings.title }}</span></div>
      </a>
      {%- if forloop.last -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .gallery { background: #fcfbf7; padding: 80px 80px 90px; }
  .gallery-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 36px; }
  .gallery-header .section-heading { margin-bottom: 0; }
  .gallery-rows { display: flex; flex-direction: column; gap: 12px; }
  .gallery-row { display: flex; gap: 12px; height: 300px; }
  .gallery-item { position: relative; overflow: hidden; border-radius: 6px; flex-shrink: 0; display: block; cursor: pointer; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s ease; }
  .gallery-item svg.gallery-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #d9d2c5 0%, #bdb2a0 100%); fill: rgba(255,255,255,0.5); }
  .gallery-item:hover img { transform: scale(1.05); }
  .g-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(30,24,18,0.70) 0%, transparent 55%); opacity: 0; transition: opacity 0.3s ease; }
  .gallery-item:hover .g-overlay { opacity: 1; }
  .g-caption { position: absolute; bottom: 0; left: 0; padding: 20px; transform: translateY(8px); opacity: 0; transition: transform 0.3s ease, opacity 0.3s ease; }
  .gallery-item:hover .g-caption { transform: translateY(0); opacity: 1; }
  .g-cat { display: none; }
  .g-title { font-size: 17px; font-weight: 600; color: #fff; letter-spacing: -0.2px; }
  @media (max-width: 1100px) { .gallery { padding-left: 40px; padding-right: 40px; } }
  @media (max-width: 760px) {
    .gallery { padding: 56px 24px 64px; }
    .gallery-header { flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 24px; }
    .gallery-rows { gap: 10px; }
    .gallery-row { flex-direction: column; height: auto; gap: 10px; }
    .gallery-item { flex: 1 1 auto !important; height: 220px; }
  }
</style>

{% schema %}
{
  "name": "Galerie",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Galerie" },
    { "type": "text", "id": "link_label", "label": "Link-Text (rechts)", "default": "Alle Projekte" },
    { "type": "url",  "id": "link_url",   "label": "Link-Ziel", "default": "/pages/projekte" }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Projekt-Kachel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (hochladen)" },
        { "type": "text", "id": "image_url", "label": "Bild-URL (Fallback)", "info": "Default-Bild, wird vom Upload überschrieben." },
        { "type": "text", "id": "title", "label": "Titel", "default": "Projekt" },
        { "type": "text", "id": "category", "label": "Kategorie (nicht sichtbar, nur Metadatum)" },
        { "type": "url",  "id": "url", "label": "Verlinktes Ziel", "default": "/pages/projekte" },
        { "type": "range", "id": "width", "min": 1, "max": 5, "step": 1, "default": 2, "label": "Breite in der Reihe (Gewichtung)", "info": "Größere Zahl = breiter relativ zu den anderen in derselben Zeile." },
        { "type": "checkbox", "id": "new_row", "label": "Neue Zeile ab hier beginnen", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Galerie" }]
}
{% endschema %}
