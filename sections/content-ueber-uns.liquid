{%- comment -%} Full Über-uns page rendered as one editable static section. {%- endcomment -%}

<div class="page-header">
  <h1 class="page-title reveal">{{ section.settings.title }}</h1>
</div>

{%- if section.settings.intro_heading != blank -%}
<section class="about-intro">
  <h2 class="reveal">{{ section.settings.intro_heading }}</h2>
  {%- if section.settings.intro_lead != blank -%}<p class="about-intro-lead reveal reveal-d1">{{ section.settings.intro_lead }}</p>{%- endif -%}
  {%- if section.settings.intro_body != blank -%}<div class="about-intro-body reveal reveal-d2">{{ section.settings.intro_body }}</div>{%- endif -%}
</section>
{%- endif -%}

{%- assign alt_i = 0 -%}
<div class="alt-sections">
  {%- for block in section.blocks -%}
    {%- if block.type == 'alt-row' -%}
      {%- assign alt_i = alt_i | plus: 1 -%}
      {%- assign odd = alt_i | modulo: 2 -%}
      <div class="alt-section{% if odd == 0 %} reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="alt-text reveal">
          <div class="alt-num">{{ alt_i | prepend: '0' | slice: -2, 2 }}</div>
          {%- if block.settings.subtitle != blank -%}<div class="alt-subtitle">{{ block.settings.subtitle }}</div>{%- endif -%}
          <h2 class="alt-heading">{{ block.settings.heading }}</h2>
          <div class="alt-body">{{ block.settings.body }}</div>
        </div>
        <div class="alt-img reveal reveal-d2">
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" />
          {%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy" />{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- if section.settings.cta_title != blank -%}
<section class="cta reveal">
  <div>
    {%- if section.settings.cta_label != blank -%}<p class="cta-label">{{ section.settings.cta_label }}</p>{%- endif -%}
    <h2 class="cta-title">{{ section.settings.cta_title }}</h2>
  </div>
  {%- if section.settings.cta_button != blank -%}<a href="{{ section.settings.cta_url | default: '/pages/kontakt' }}" class="btn-orange">{{ section.settings.cta_button }} &nbsp;→</a>{%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Über-uns-Inhalt",
  "settings": [
    { "type": "header", "content": "Seitenkopf" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Über uns" },
    { "type": "header", "content": "Intro-Block" },
    { "type": "text", "id": "intro_heading", "label": "Überschrift", "default": "MOQU..." },
    { "type": "textarea", "id": "intro_lead", "label": "Lead", "default": "...steht für Modern Quality – und zugleich für unsere tiefe Verbundenheit zum Werkstoff Holz. Abgeleitet vom japanischen Wort für Holz (木, moku), vereint der Name Tradition und zeitgemäßen Anspruch." },
    { "type": "richtext", "id": "intro_body", "label": "Fließtext (2-spaltig)", "default": "<p>Seit über 30 Jahren entstehen bei uns Möbel und Innenausbauten mit Substanz. Was mit klassischer Handwerksarbeit begann, entwickelt sich heute zu einem modernen Meisterbetrieb.</p><p>MOQU ist gewachsen – wie Holz selbst.</p><p>Der Gründer Tilo legte den Grundstein mit handwerklicher Präzision.</p><p>Heute führt Simon diesen Weg fort.</p>" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_label", "label": "CTA-Eyebrow", "default": "Bereit loszulegen?" },
    { "type": "text", "id": "cta_title", "label": "CTA-Titel", "default": "Lass uns dein Projekt besprechen." },
    { "type": "text", "id": "cta_button", "label": "CTA-Button", "default": "Kontakt aufnehmen" },
    { "type": "url", "id": "cta_url", "label": "CTA-Ziel", "default": "/pages/kontakt" }
  ],
  "max_blocks": 12,
  "blocks": [
    { "type": "alt-row", "name": "Bild/Text-Block", "settings": [
      { "type": "image_picker", "id": "image", "label": "Bild (hochladen)" },
      { "type": "text", "id": "image_url", "label": "Bild-URL (Fallback)" },
      { "type": "text", "id": "subtitle", "label": "Subtitle (orange)" },
      { "type": "text", "id": "heading", "label": "Überschrift" },
      { "type": "richtext", "id": "body", "label": "Text" }
    ] }
  ],
  "default": {
    "blocks": [
      { "type": "alt-row", "settings": { "image_url": "https://images.unsplash.com/photo-1497219055242-93359eeed651?w=900&q=85", "subtitle": "Gewachsen aus Erfahrung. Verankert in Magdeburg.", "heading": "Handwerk mit Herkunft", "body": "<p>Unsere Arbeit ist fest mit der Region verbunden. Die Landschaft und das ruhige, beständige Fließen prägen unsere Haltung.</p>" } },
      { "type": "alt-row", "settings": { "image_url": "https://images.unsplash.com/photo-1684069158042-de27cd720172?w=900&q=85", "subtitle": "Verantwortung übernehmen, neu denken.", "heading": "Generationswechsel mit Haltung", "body": "<p>Der Gründer Tilo legte den Grundstein mit handwerklicher Präzision. Heute führt Simon diesen Weg fort – mit dem Ziel, das Handwerk weiterzudenken.</p>" } },
      { "type": "alt-row", "settings": { "image_url": "https://images.unsplash.com/photo-1764526624453-db32c24eca55?w=900&q=85", "subtitle": "Das Beste aus beiden Welten.", "heading": "Moderne Qualität", "body": "<p>Modernste CNC-Technik trifft auf traditionsreiches Handwerk. So entstehen Möbel, die höchsten Ansprüchen genügen.</p>" } },
      { "type": "alt-row", "settings": { "image_url": "https://images.unsplash.com/photo-1683181181300-44c0c991a2cf?w=900&q=85", "subtitle": "Gemeinsam für das beste Ergebnis.", "heading": "Ein Team, ein Anspruch", "body": "<p>Unser Team aus Tischlern, Gestaltern und Projektmanagern arbeitet Hand in Hand — vom Entwurf bis zur Montage.</p>" } }
    ]
  }
}
{% endschema %}
