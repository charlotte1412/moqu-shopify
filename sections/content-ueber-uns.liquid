{%- comment -%} Full Über-uns page with fallback. {%- endcomment -%}

<div class="page-header">
  <h1 class="page-title reveal">{{ section.settings.title | default: 'Über uns' }}</h1>
</div>

<section class="about-intro">
  <h2 class="reveal">{{ section.settings.intro_heading | default: 'MOQU...' }}</h2>
  {%- if section.settings.intro_lead != blank -%}<p class="about-intro-lead reveal reveal-d1">{{ section.settings.intro_lead }}</p>
  {%- else -%}<p class="about-intro-lead reveal reveal-d1">...steht für Modern Quality – und zugleich für unsere tiefe Verbundenheit zum Werkstoff Holz. Abgeleitet vom japanischen Wort für Holz (木, moku), vereint der Name Tradition und zeitgemäßen Anspruch.</p>{%- endif -%}
  {%- if section.settings.intro_body != blank -%}<div class="about-intro-body reveal reveal-d2">{{ section.settings.intro_body }}</div>
  {%- else -%}<div class="about-intro-body reveal reveal-d2"><p>Seit über 30 Jahren entstehen bei uns Möbel und Innenausbauten mit Substanz. Was mit klassischer Handwerksarbeit begann, entwickelt sich heute zu einem modernen Meisterbetrieb für individuellen Möbelbau, hochwertigen Innenausbau und klare Raumkonzepte.</p><p>MOQU ist gewachsen – wie Holz selbst. Geprägt von Erfahrung, weitergeführt mit neuer Perspektive.</p><p>Der Gründer Tilo legte den Grundstein mit handwerklicher Präzision, Verlässlichkeit und dem Anspruch, jedes Möbelstück sorgfältig und individuell zu fertigen.</p><p>Heute führt Simon diesen Weg fort – mit dem Ziel, das Handwerk weiterzudenken, alte Stereotype der Tischlerei aufzubrechen und Möbelbau sowie Innenausbau moderner, klarer und gestalterischer zu interpretieren.</p></div>{%- endif -%}
</section>

{%- assign alt_count = 0 -%}
{%- for block in section.blocks -%}{%- if block.type == 'alt-row' -%}{%- assign alt_count = alt_count | plus: 1 -%}{%- endif -%}{%- endfor -%}

<div class="alt-sections">
{%- if alt_count > 0 -%}
  {%- assign alt_i = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'alt-row' -%}
      {%- assign alt_i = alt_i | plus: 1 -%}
      {%- assign odd = alt_i | modulo: 2 -%}
      <div class="alt-section{% if odd == 0 %} reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="alt-text reveal">
          <div class="alt-num">{{ alt_i | prepend: '0' | slice: -2, 2 }}</div>
          {%- if block.settings.subtitle != blank -%}<div class="alt-subtitle">{{ block.settings.subtitle }}</div>{%- endif -%}
          <h2 class="alt-heading">{{ block.settings.heading }}</h2>
          <div class="alt-body">{{ block.settings.body }}</div>
        </div>
        <div class="alt-img reveal reveal-d2">
          {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" />
          {%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy" />{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  <div class="alt-section"><div class="alt-text reveal"><div class="alt-num">01</div><div class="alt-subtitle">Gewachsen aus Erfahrung. Verankert in Magdeburg.</div><h2 class="alt-heading">Handwerk mit Herkunft</h2><p class="alt-body">Unsere Arbeit ist fest mit der Region verbunden. Die Landschaft und das ruhige, beständige Fließen prägen unsere Haltung.</p></div><div class="alt-img reveal reveal-d2"><img src="https://images.unsplash.com/photo-1497219055242-93359eeed651?w=900&q=85" alt="Handwerk" loading="lazy" /></div></div>
  <div class="alt-section reverse"><div class="alt-text reveal"><div class="alt-num">02</div><div class="alt-subtitle">Verantwortung übernehmen, neu denken.</div><h2 class="alt-heading">Generationswechsel mit Haltung</h2><p class="alt-body">Der Gründer Tilo legte den Grundstein mit handwerklicher Präzision. Heute führt Simon diesen Weg fort – mit dem Ziel, das Handwerk weiterzudenken.</p></div><div class="alt-img reveal reveal-d2"><img src="https://images.unsplash.com/photo-1684069158042-de27cd720172?w=900&q=85" alt="Generationswechsel" loading="lazy" /></div></div>
  <div class="alt-section"><div class="alt-text reveal"><div class="alt-num">03</div><div class="alt-subtitle">Das Beste aus beiden Welten.</div><h2 class="alt-heading">Moderne Qualität</h2><p class="alt-body">Modernste CNC-Technik trifft auf traditionsreiches Handwerk. So entstehen Möbel, die höchsten Ansprüchen genügen.</p></div><div class="alt-img reveal reveal-d2"><img src="https://images.unsplash.com/photo-1764526624453-db32c24eca55?w=900&q=85" alt="Moderne Qualität" loading="lazy" /></div></div>
  <div class="alt-section reverse"><div class="alt-text reveal"><div class="alt-num">04</div><div class="alt-subtitle">Gemeinsam für das beste Ergebnis.</div><h2 class="alt-heading">Ein Team, ein Anspruch</h2><p class="alt-body">Unser Team aus Tischlern, Gestaltern und Projektmanagern arbeitet Hand in Hand — vom Entwurf bis zur Montage.</p></div><div class="alt-img reveal reveal-d2"><img src="https://images.unsplash.com/photo-1683181181300-44c0c991a2cf?w=900&q=85" alt="Team" loading="lazy" /></div></div>
{%- endif -%}
</div>

<section class="cta reveal">
  <div>
    {%- if section.settings.cta_label != blank -%}<p class="cta-label">{{ section.settings.cta_label }}</p>{%- endif -%}
    <h2 class="cta-title">{{ section.settings.cta_title | default: 'Lass uns dein Projekt besprechen.' }}</h2>
  </div>
  <a href="{{ section.settings.cta_url | default: '/pages/kontakt' }}" class="btn-orange">{{ section.settings.cta_button | default: 'Kontakt aufnehmen' }} &nbsp;→</a>
</section>

{% schema %}
{
  "name": "Über-uns-Inhalt",
  "settings": [
    { "type": "paragraph", "content": "Bearbeitbarer Content. Default-Blöcke werden angezeigt, bis du eigene hinzufügst." },
    { "type": "header", "content": "Seitenkopf" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Über uns" },
    { "type": "header", "content": "Intro-Block" },
    { "type": "text", "id": "intro_heading", "label": "Überschrift", "default": "MOQU..." },
    { "type": "textarea", "id": "intro_lead", "label": "Lead" },
    { "type": "richtext", "id": "intro_body", "label": "Fließtext (2-spaltig)" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_label", "label": "Eyebrow", "default": "Bereit loszulegen?" },
    { "type": "text", "id": "cta_title", "label": "Titel", "default": "Lass uns dein Projekt besprechen." },
    { "type": "text", "id": "cta_button", "label": "Button", "default": "Kontakt aufnehmen" },
    { "type": "url", "id": "cta_url", "label": "Ziel", "default": "/pages/kontakt" }
  ],
  "max_blocks": 12,
  "blocks": [
    { "type": "alt-row", "name": "Bild/Text-Block", "settings": [
      { "type": "image_picker", "id": "image", "label": "Bild (hochladen)" },
      { "type": "text", "id": "image_url", "label": "Bild-URL (Fallback)" },
      { "type": "text", "id": "subtitle", "label": "Subtitle (orange)" },
      { "type": "text", "id": "heading", "label": "Überschrift" },
      { "type": "richtext", "id": "body", "label": "Text" }
    ] }
  ]
}
{% endschema %}
