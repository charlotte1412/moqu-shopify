<footer>
  <div class="footer-grid">
    <div>
      <div class="footer-logo">
        {% if settings.logo_image != blank %}
          <img src="{{ settings.logo_image | image_url: width: 300 }}" alt="{{ settings.company_name | default: shop.name | escape }}" style="max-height: 40px; width: auto; display: block;">
        {% else %}
          {{ settings.company_name | default: shop.name | default: 'MOQU' }}
        {% endif %}
      </div>
      <p class="footer-desc">{{ settings.company_description | default: 'Individuelle Raum- und Einrichtungslösungen in Meisterqualität.' }}</p>
    </div>
    <div>
      <div class="footer-col-title">Seiten</div>
      <ul class="footer-links">
        <li><a href="/pages/projekte">Projekte</a></li>
        <li><a href="/pages/moebelbau">Möbelbau</a></li>
        <li><a href="/pages/innenausbau">Innenausbau</a></li>
        <li><a href="/pages/kuechenbau">Küchenbau</a></li>
        <li><a href="/pages/ueber-uns">Über uns</a></li>
        <li><a href="/pages/kontakt">Kontakt</a></li>
      </ul>
    </div>
    <div>
      <div class="footer-col-title">Kontakt</div>
      <div class="footer-contact">
        {% if settings.address_street != blank %}
          <p>{{ settings.address_street }}<br>{{ settings.address_zip }} {{ settings.address_city }}</p>
        {% endif %}
        {% if settings.contact_phone != blank %}
          <p>{{ settings.contact_phone }}</p>
        {% endif %}
        {% if settings.contact_email != blank %}
          <p><a href="mailto:{{ settings.contact_email }}" style="color:inherit;">{{ settings.contact_email }}</a></p>
        {% endif %}
      </div>
    </div>
    <div>
      <div class="footer-col-title">Rechtliches</div>
      <ul class="footer-links">
        <li><a href="/pages/datenschutz">Datenschutz</a></li>
        <li><a href="/pages/agb">AGB</a></li>
        <li><a href="/pages/impressum">Impressum</a></li>
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
