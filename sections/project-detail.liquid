<section class="projekt-hero">
  {% if section.settings.hero_image != blank %}
    <div class="projekt-hero-bg" style="background-image:url('{{ section.settings.hero_image | image_url: width: 2400 }}');"></div>
  {% elsif section.settings.hero_image_url != blank %}
    <div class="projekt-hero-bg" style="background-image:url('{{ section.settings.hero_image_url }}');"></div>
  {% else %}
    <div class="projekt-hero-bg"></div>
  {% endif %}
  <div class="projekt-hero-content">
    {% if section.settings.category != blank %}
      <span class="projekt-cat">{{ section.settings.category }}</span>
    {% endif %}
    <h1 class="projekt-title">{{ section.settings.title | default: page.title }}</h1>
    {% if section.settings.year != blank %}
      <p class="projekt-year">{{ section.settings.year }}</p>
    {% endif %}
  </div>
</section>

<section class="projekt-body">
  <div class="projekt-grid">
    <aside class="projekt-meta">
      {% if section.settings.meta_auftraggeber != blank %}
        <div class="projekt-meta-item"><span class="projekt-meta-key">Auftraggeber</span><span class="projekt-meta-val">{{ section.settings.meta_auftraggeber }}</span></div>
      {% endif %}
      {% if section.settings.meta_leistung != blank %}
        <div class="projekt-meta-item"><span class="projekt-meta-key">Leistung</span><span class="projekt-meta-val">{{ section.settings.meta_leistung }}</span></div>
      {% endif %}
      {% if section.settings.meta_standort != blank %}
        <div class="projekt-meta-item"><span class="projekt-meta-key">Standort</span><span class="projekt-meta-val">{{ section.settings.meta_standort }}</span></div>
      {% endif %}
    </aside>
    <div class="projekt-content">
      {% if section.settings.lead != blank %}
        <p class="projekt-lead">{{ section.settings.lead }}</p>
      {% endif %}
      <div class="projekt-rich">{{ page.content }}</div>
    </div>
  </div>

  <div class="projekt-gallery">
    {% for block in section.blocks %}
      <div class="projekt-gallery-item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.caption | default: section.settings.title | escape }}" loading="lazy">
        {% elsif block.settings.image_url != blank %}
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.caption | default: section.settings.title | escape }}" loading="lazy">
        {% endif %}
        {% if block.settings.caption != blank %}
          <p class="projekt-gallery-caption">{{ block.settings.caption }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <a href="/pages/projekte" class="projekt-back">← Alle Projekte</a>
</section>

{% schema %}
{
  "name": "Projekt-Detail",
  "max_blocks": 12,
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero-Bild (hochladen)" },
    { "type": "text", "id": "hero_image_url", "label": "Hero-Bild-URL (Fallback)" },
    { "type": "text", "id": "title", "label": "Projekt-Titel" },
    { "type": "text", "id": "category", "label": "Kategorie" },
    { "type": "text", "id": "year", "label": "Jahr" },
    { "type": "text", "id": "meta_auftraggeber", "label": "Auftraggeber" },
    { "type": "text", "id": "meta_leistung", "label": "Leistung" },
    { "type": "text", "id": "meta_standort", "label": "Standort" },
    { "type": "textarea", "id": "lead", "label": "Einleitungssatz" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Projekt-Bild",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (hochladen)" },
        { "type": "text", "id": "image_url", "label": "Bild-URL (Fallback)" },
        { "type": "text", "id": "caption", "label": "Bildunterschrift" }
      ]
    }
  ],
  "presets": [{ "name": "Projekt-Detail" }]
}
{% endschema %}
