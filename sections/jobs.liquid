<section class="jobs" id="stellenanzeigen">
  <div class="jobs-header">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subtitle != blank %}
      <p class="jobs-sub">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
  <div class="job-list">
    {% for block in section.blocks %}
      <a class="job-card" href="{{ block.settings.url | default: '/pages/kontakt' }}" {{ block.shopify_attributes }}>
        <div>
          <div class="job-title">{{ block.settings.title }}</div>
          <div class="job-desc">{{ block.settings.desc }}</div>
        </div>
        <span class="job-arrow">→</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Stellenanzeigen",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Stellenanzeigen" },
    { "type": "text", "id": "subtitle", "label": "Untertitel" }
  ],
  "blocks": [
    {
      "type": "job",
      "name": "Stelle",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "desc", "label": "Kurzbeschreibung" },
        { "type": "url", "id": "url", "label": "Bewerbungs-Ziel" }
      ]
    }
  ],
  "presets": [{ "name": "Stellenanzeigen" }]
}
{% endschema %}
