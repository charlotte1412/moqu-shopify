<section class="about-intro">
  <h2>{{ section.settings.heading }}</h2>
  {% if section.settings.lead != blank %}
    <p class="about-intro-lead">{{ section.settings.lead }}</p>
  {% endif %}
  {% if section.settings.body != blank %}
    <div class="about-intro-body">{{ section.settings.body }}</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Über-uns Intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "MOQU..." },
    { "type": "textarea", "id": "lead", "label": "Lead-Absatz" },
    { "type": "richtext", "id": "body", "label": "Fließtext (2-spaltig)" }
  ],
  "presets": [{ "name": "Über-uns Intro" }]
}
{% endschema %}
