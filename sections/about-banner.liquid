<section class="about-banner">
  {% if section.settings.image != blank %}
    <div class="about-bg" style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}');"></div>
  {% elsif section.settings.image_url != blank %}
    <div class="about-bg" style="background-image:url('{{ section.settings.image_url }}');"></div>
  {% else %}
    <div class="about-bg"></div>
  {% endif %}
  <div class="about-content">
    {% if section.settings.label != blank %}
      <p class="about-label">{{ section.settings.label }}</p>
    {% endif %}
    <h2 class="about-title">{{ section.settings.title }}</h2>
    {% if section.settings.link_label != blank %}
      <a href="{{ section.settings.link_url | default: '/pages/ueber-uns' }}" class="link-text">{{ section.settings.link_label }} &nbsp;→</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Über-uns-Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild (hochladen)" },
    { "type": "text", "id": "image_url", "label": "Hintergrundbild-URL (Fallback)" },
    { "type": "text", "id": "label", "label": "Eyebrow-Label" },
    { "type": "text", "id": "title", "label": "Überschrift" },
    { "type": "text", "id": "link_label", "label": "Link-Text" },
    { "type": "url", "id": "link_url", "label": "Link-Ziel" }
  ],
  "presets": [{ "name": "Über-uns-Banner" }]
}
{% endschema %}
