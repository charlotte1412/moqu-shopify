<section class="moqu-quality moqu-section">
  <div class="moqu-reveal">
    {%- if section.settings.label != blank -%}
      <div class="moqu-moqu-label">
        {%- if section.settings.kanji != blank -%}<span class="moqu-kanji">{{ section.settings.kanji }}</span>{%- endif -%}
        <span class="moqu-divider"></span>
        <span>{{ section.settings.label }}</span>
      </div>
    {%- endif -%}
    <h2 class="moqu-section-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="moqu-section-body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>

  <div class="moqu-cards">
    {%- for block in section.blocks -%}
      <div class="moqu-card moqu-reveal" {{ block.shopify_attributes }}>
        <span class="moqu-card-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <h3 class="moqu-card-title">{{ block.settings.title }}</h3>
        <p class="moqu-card-body">{{ block.settings.body }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "MOQU · Quality Cards",
  "settings": [
    { "type": "text", "id": "kanji", "label": "Kanji/Symbol", "default": "木" },
    { "type": "text", "id": "label", "label": "Eyebrow-Label", "default": "MODERN QUALITY" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Handwerk, das Räume prägt." },
    { "type": "textarea", "id": "body", "label": "Fließtext",
      "default": "Von der ersten Skizze bis zur Montage – alles aus einer Hand." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        { "type": "text",     "id": "title", "label": "Titel", "default": "Qualität" },
        { "type": "textarea", "id": "body",  "label": "Beschreibung" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "card", "settings": { "title": "Beratung",   "body": "Persönlich, individuell und immer auf deine Bedürfnisse zugeschnitten." } },
      { "type": "card", "settings": { "title": "Planung",    "body": "Detailgenaue Planung mit 3D-Visualisierung und Materialmustern." } },
      { "type": "card", "settings": { "title": "Fertigung",  "body": "CNC-Präzision trifft handwerkliche Sorgfalt in unserer Werkstatt." } },
      { "type": "card", "settings": { "title": "Montage",    "body": "Saubere Montage durch unser eigenes Team – pünktlich und verlässlich." } }
    ]
  },
  "presets": [{ "name": "MOQU · Quality Cards" }]
}
{% endschema %}
