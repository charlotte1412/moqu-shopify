<section class="contact-section">
  <p class="contact-heading">{{ section.settings.heading | default: 'Kontaktiere uns.' }}</p>

  {% form 'contact' %}
    {% if form.posted_successfully? %}
      <div class="form-success">{{ section.settings.success_message | default: 'Danke! Wir melden uns zeitnah.' }}</div>
    {% endif %}
    {% if form.errors %}
      <div class="form-error">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="radio-group">
      <label class="radio-label"><input type="radio" name="contact[Kundentyp]" value="Privatkunde" checked> Privatkunde</label>
      <label class="radio-label"><input type="radio" name="contact[Kundentyp]" value="Gewerblicher Kunde"> Gewerblicher Kunde</label>
    </div>

    <div class="form-grid">
      <div class="form-field"><label class="form-label">Vorname</label><input type="text" name="contact[Vorname]" class="form-input" required></div>
      <div class="form-field"><label class="form-label">Nachname</label><input type="text" name="contact[Nachname]" class="form-input" required></div>
      <div class="form-field full"><label class="form-label">E-Mail</label><input type="email" name="contact[email]" class="form-input" required></div>
      <div class="form-field"><label class="form-label">Telefonnummer</label><input type="tel" name="contact[phone]" class="form-input"></div>
      <div class="form-field"><label class="form-label">Anschrift</label><input type="text" name="contact[Anschrift]" class="form-input"></div>
      <div class="form-field"><label class="form-label">Gewünschter Einbautermin</label><input type="text" name="contact[Einbautermin]" class="form-input"></div>
      <div class="form-field full"><label class="form-label">Nachricht</label><textarea name="contact[body]" class="form-textarea" rows="4"></textarea></div>
    </div>

    <div class="form-consent">
      <input type="checkbox" id="consent" name="contact[Einverstanden]" required>
      <label for="consent">Ich stimme zu, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert werden. <a href="/pages/datenschutz">Datenschutz</a>.</label>
    </div>

    <button type="submit" class="btn-orange">Abschicken &nbsp;→</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Kontaktformular",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontaktiere uns." },
    { "type": "text", "id": "success_message", "label": "Erfolgs-Nachricht", "default": "Danke! Wir melden uns zeitnah." }
  ],
  "presets": [{ "name": "Kontaktformular" }]
}
{% endschema %}
