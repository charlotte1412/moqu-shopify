<section class="moqu-keywords moqu-section">
  <div class="moqu-kw-row">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="moqu-kw-item moqu-reveal" {{ block.shopify_attributes }}>
        {%- if block.settings.icon_svg != blank -%}
          {{ block.settings.icon_svg }}
        {%- else -%}
          <svg viewBox="0 0 64 64" pathLength="1"><circle cx="32" cy="32" r="28"/></svg>
        {%- endif -%}
        <span class="moqu-kw-label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "MOQU · Keywords",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "keyword",
      "name": "Keyword",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "EINBAUSCHRÄNKE" },
        { "type": "url",  "id": "url",   "label": "Link (optional)" },
        { "type": "html", "id": "icon_svg", "label": "Icon (inline SVG)",
          "info": "Ein <svg>-Element als HTML einfügen. Stroke/Fill werden per CSS gesetzt." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "keyword", "settings": { "label": "EINBAUSCHRÄNKE" } },
      { "type": "keyword", "settings": { "label": "KÜCHEN" } },
      { "type": "keyword", "settings": { "label": "INNENAUSBAU" } },
      { "type": "keyword", "settings": { "label": "MASSMÖBEL" } }
    ]
  },
  "presets": [{ "name": "MOQU · Keywords" }]
}
{% endschema %}
