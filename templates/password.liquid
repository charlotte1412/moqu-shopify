<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; padding: 40px; text-align: center; background: #fcfbf7;">
  <div style="font-family: 'MuseoModerno', sans-serif; font-size: 48px; font-weight: 500; letter-spacing: -0.5px; margin-bottom: 32px;">{{ shop.name | default: 'MOQU' }}</div>
  <p style="font-size: 16px; color: #7e7a74; margin-bottom: 32px; max-width: 440px; line-height: 1.6;">
    {{ shop.password_message | default: 'Die Seite ist aktuell noch im Aufbau. Bitte gib das Passwort ein, um fortzufahren.' }}
  </p>
  {% form 'storefront_password', style: 'display:flex;gap:10px;' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Passwort"
           style="padding:12px 16px; border:1px solid rgba(0,0,0,0.15); border-radius:6px; font-size:15px;">
    <button type="submit" class="btn-orange" style="padding:12px 22px;">Enter</button>
  {% endform %}
</div>
