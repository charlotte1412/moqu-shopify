{%- comment -%}
  Fallback page template — zeigt Shopify-CMS-Inhalt wenn keine spezielle Vorlage existiert.
{%- endcomment -%}
<section class="page-header">
  <h1 class="page-title reveal">{{ page.title }}</h1>
</section>

<section class="legal-section" style="background: var(--bg, #fcfbf7); padding: 50px 80px 90px;">
  <div class="legal-body" style="max-width: 860px; margin: 0 auto; font-size: 15.5px; line-height: 1.8; color: #3a3530;">
    {{ page.content }}
  </div>
</section>
