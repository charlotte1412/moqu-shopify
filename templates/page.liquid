{%- comment -%}
  Handle-basierter Auto-Router.
  Rendert je nach Page-Handle die passende editierbare Section.
  Alle Sections sind im Theme-Editor voll bearbeitbar (Bilder, Texte, Blöcke).
  Für unbekannte Handles → Rich-Text aus Pages-Admin (AGB/Datenschutz/Impressum).
{%- endcomment -%}

{%- case page.handle -%}

  {%- when 'moebelbau' -%}
    {% section 'content-moebelbau' %}

  {%- when 'innenausbau' -%}
    {% section 'content-innenausbau' %}

  {%- when 'kuechenbau' -%}
    {% section 'content-kuechenbau' %}

  {%- when 'ueber-uns' -%}
    {% section 'content-ueber-uns' %}

  {%- when 'projekte' -%}
    {% section 'content-projekte' %}

  {%- when 'kontakt' -%}
    {% section 'content-kontakt' %}

  {%- else -%}
    {%- comment -%} Generische Seite (AGB, Datenschutz, Impressum, …) {%- endcomment -%}
    <div class="page-header page-header--plain">
      <h1 class="page-title reveal">{{ page.title }}</h1>
    </div>
    <section class="page-section">
      <div class="page-body rte">
        {{ page.content }}
      </div>
    </section>

    <style>
      .page-header--plain { padding: 120px 80px 40px; text-align: center; }
      .page-header--plain .page-title { font-size: clamp(34px, 4vw, 52px); letter-spacing: -0.6px; line-height: 1.1; font-weight: 600; font-family: 'MuseoModerno', sans-serif; }
      @media (max-width: 1100px) { .page-header--plain { padding: 100px 40px 32px; } }
      @media (max-width: 760px)  { .page-header--plain { padding: 90px 24px 24px; } .page-header--plain .page-title { font-size: clamp(28px, 7vw, 40px); } }

      .page-section { padding: 10px 80px 100px; }
      .page-body { max-width: 860px; margin: 0 auto; font-size: 16px; line-height: 1.82; color: #3a3530; }
      .page-body > :first-child { margin-top: 0; }
      .page-body h2 { font-family: 'MuseoModerno', sans-serif; font-size: clamp(24px, 3vw, 32px); font-weight: 600; color: #1a1a18; letter-spacing: -0.3px; line-height: 1.22; margin: 44px 0 16px; }
      .page-body h3 { font-family: 'MuseoModerno', sans-serif; font-size: 20px; font-weight: 600; color: #1a1a18; margin: 28px 0 10px; }
      .page-body p { margin-bottom: 16px; }
      .page-body ul, .page-body ol { padding-left: 22px; margin-bottom: 16px; }
      .page-body li { margin-bottom: 6px; }
      .page-body a { color: var(--accent, #c8772a); text-decoration: underline; }
      .page-body em { color: var(--accent, #c8772a); font-style: normal; font-size: 13px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; display: block; margin: 32px 0 -8px; }
      .page-body strong { color: #1a1a18; font-weight: 600; }
      .page-body img { max-width: 100%; height: auto; border-radius: 6px; margin: 24px 0; display: block; }
      .page-body blockquote { border-left: 3px solid var(--accent, #c8772a); padding: 4px 0 4px 22px; margin: 28px 0; font-style: italic; color: #5a5550; }
      @media (max-width: 1100px) { .page-section { padding: 10px 40px 80px; } }
      @media (max-width: 760px)  { .page-section { padding: 10px 24px 60px; } }
    </style>

{%- endcase -%}
