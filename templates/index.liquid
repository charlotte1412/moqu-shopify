    .card {
      background: #fff;
      border-radius: 10px;
      padding: 44px 32px 48px;
      border: 1px solid rgba(0,0,0,0.05);
      position: relative;
      overflow: hidden;
      min-height: 300px;
      transition: border-color 0.25s, box-shadow 0.3s, transform 0.3s;
    }
    .card:hover {
      border-color: rgba(200,119,42,0.22);
      box-shadow: 0 12px 40px rgba(0,0,0,0.1);
      transform: translateY(-5px);
    }
    .card-num {
      display: block;
      font-family: 'MuseoModerno', sans-serif;
      font-size: 11px;
      font-weight: 700;
      color: var(--accent, #c8772a);
      letter-spacing: 3.5px;
      margin-bottom: 26px;
    }
    .card-icon {
      position: absolute;
      right: -16px;
      bottom: -16px;
      width: 150px;
      height: 150px;
      color: rgba(200,119,42,0.07);
      stroke-width: 0.75;
      fill: none;
      stroke: currentColor;
      pointer-events: none;
    }
    .card-title {
      font-size: 23px;
