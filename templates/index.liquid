      color: #1a1a18;
      margin-bottom: 14px;
      line-height: 1.18;
      position: relative;
      z-index: 1;
    }
    .card-body {
      font-size: 14.5px;
      color: #8a8680;
      line-height: 1.72;
      position: relative;
      z-index: 1;
    }

    /* ── ABOUT BANNER ── */
    .about-banner {
      position: relative;
      height: 400px;
      display: flex;
      align-items: center;
      justify-content: center;
