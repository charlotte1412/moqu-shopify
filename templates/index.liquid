<style>
/* ── HERO ── */
    @keyframes heroFadeUp {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes heroBgIn {
      from { transform: scale(1.06); }
      to   { transform: scale(1); }
    }
    .hero {
      position: relative;
      height: 100vh;
      min-height: 620px;
      display: flex;
      align-items: flex-end;
      padding: 0 80px 100px;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      animation: heroBgIn 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(10,7,4,0.30) 0%,
        rgba(10,7,4,0.10) 55%,
        rgba(10,7,4,0.02) 100%
      );
    }
    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 720px;
    }
    .hero-title {
      font-size: clamp(48px, 6.5vw, 88px);
      font-weight: 800;
      color: #fff;
      line-height: 1.04;
      margin-bottom: 22px;
      letter-spacing: -1.5px;
      animation: heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }
    .hero-sub {
      font-size: 17px;
      color: rgba(255,255,255,0.85);
      margin-bottom: 38px;
      line-height: 1.55;
      animation: heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.26s both;
    }
    .hero-content .btn-orange {
      animation: heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    }

    /* ── KEYWORDS ── */
    .keywords-section {
      background: #fcfbf7;
      padding: 80px 80px 40px;
    }
    .kw-icons-row {
      display: flex;
      justify-content: space-evenly;
      align-items: center;
    }
    .kw-icon-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 14px;
      min-height: 100px;
      opacity: 0;
      transition: opacity 0.75s cubic-bezier(0.16,1,0.3,1);
    }
    .kw-icon-item.kw-visible {
      opacity: 1;
    }
    .kw-icon-item svg {
      width: 68px;
      height: 68px;
      stroke: var(--icon-color, var(--accent, #c8772a));
      stroke-width: 0.85;
      fill: none;
      overflow: visible;
    }
    /* pathLength="1" normalises dasharray – enables draw-on-hover */
    .kw-icon-item svg [pathLength] {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
      opacity: 0.2;
      transition: opacity 0.4s ease;
    }
    .kw-icon-item:hover svg [pathLength] { opacity: 1; }
    @keyframes kwDraw {
      from { stroke-dashoffset: 1; }
      to   { stroke-dashoffset: 0; }
    }
    .kw-icon-item:hover svg [pathLength]:nth-child(1) { animation: kwDraw 0.5s 0.00s ease both; }
    .kw-icon-item:hover svg [pathLength]:nth-child(2) { animation: kwDraw 0.5s 0.08s ease both; }
    .kw-icon-item:hover svg [pathLength]:nth-child(3) { animation: kwDraw 0.5s 0.16s ease both; }
    .kw-icon-item:hover svg [pathLength]:nth-child(4) { animation: kwDraw 0.5s 0.24s ease both; }
    .kw-icon-item:hover svg [pathLength]:nth-child(5) { animation: kwDraw 0.5s 0.32s ease both; }
    .kw-icon-item:hover svg [pathLength]:nth-child(6) { animation: kwDraw 0.5s 0.40s ease both; }
    .kw-icon-item:hover svg [pathLength]:nth-child(7) { animation: kwDraw 0.5s 0.48s ease both; }
    .kw-icon-label {
      font-size: 12.5px;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #1a1a18;
      white-space: nowrap;
      transition: color 0.35s ease;
    }
    .kw-icon-item:hover .kw-icon-label { color: var(--accent, #c8772a); }
    a.kw-icon-item { text-decoration: none; }

    /* ── QUALITY ── */
    .quality {
      background: #fcfbf7;
      padding: 40px 80px 80px;
    }
