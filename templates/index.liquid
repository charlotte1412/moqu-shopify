      display: block;
      transition: transform 0.7s ease;
    }
    .gallery-item:hover img { transform: scale(1.05); }
    .g-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(30,24,18,0.70) 0%, transparent 55%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .gallery-item:hover .g-overlay { opacity: 1; }
    .g-caption {
      position: absolute;
