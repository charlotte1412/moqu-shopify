      .quality, .gallery, .jobs { padding-left: 40px; padding-right: 40px; }
      .quality { padding-top: 32px; }
      .cards { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 760px) {
      .hero { padding: 0 24px 60px; min-height: 520px; }
      .hero-title { font-size: clamp(30px, 8.5vw, 48px); letter-spacing: -0.5px; }
      .hero-sub { font-size: 15.5px; }
      .quality, .jobs { padding-left: 24px; padding-right: 24px; }
      .gallery { padding: 56px 24px 64px; }
      .jobs { padding-top: 56px; padding-bottom: 72px; }
      .keywords-section { padding: 48px 16px 28px; }
      .kw-icons-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 0; justify-items: center; }
      .kw-icon-item { flex: none; min-height: auto; min-width: 0; width: 100%; }
      .kw-icon-item svg { width: 42px; height: 42px; }
      .kw-icon-label { font-size: 8.5px; letter-spacing: 1.2px; white-space: normal; text-align: center; }
      .quality { padding-top: 24px; padding-bottom: 56px; }
      .quality-intro { margin-bottom: 40px; }
      .cards { grid-template-columns: 1fr; }
      .card { min-height: auto; padding: 36px 28px 40px; }
      .card-title { font-size: 20px; }
      .about-banner { height: 320px; }
      .gallery-header { flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 24px; }
      .gallery-rows { gap: 10px; }
      .gallery-row { flex-direction: column; height: auto; gap: 10px; }
      .gallery-item { flex: 1 1 auto !important; height: 220px; }
      .jobs-header { margin-bottom: 32px; }
      .job-card { padding: 22px 20px; gap: 14px; }
      .job-title { font-size: 15.5px; }
      .job-desc { font-size: 13px; }
