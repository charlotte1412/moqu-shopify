    }

    /* ── GALLERY ── */
    .gallery {
      background: #fcfbf7;
      padding: 80px 80px 90px;
    }
    .gallery-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 36px;
    }
