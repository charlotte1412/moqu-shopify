<section class="page-header"><h1 class="page-title">{{ blog.title }}</h1></section>
<section style="padding: 40px 80px 80px; max-width: 860px; margin: 0 auto;">
  {% for article in blog.articles %}
    <a href="{{ article.url }}" style="display:block; padding:20px 0; border-bottom:1px solid rgba(0,0,0,0.08); color:inherit; text-decoration:none;">
      <h3>{{ article.title }}</h3>
      <p>{{ article.excerpt | strip_html | truncate: 180 }}</p>
    </a>
  {% endfor %}
</section>
