<style>
.contact-heading {
      font-size: clamp(22px, 2.5vw, 30px);
      font-weight: 700;
      color: #1a1a18;
      margin-bottom: 40px;
      letter-spacing: -0.3px;
      line-height: 1.3;
    }
    /* Honeypot – unsichtbar für Menschen */
    .form-hp { position: absolute; left: -9999px; opacity: 0; pointer-events: none; tab-index: -1; }
    /* Einwilligungs-Checkbox */
    .form-consent { display: flex; align-items: flex-start; gap: 12px; margin-top: 20px; }
    .form-consent input[type="checkbox"] { flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent, #c8772a); cursor: pointer; }
    .form-consent label { font-size: 14px; color: #5a5550; line-height: 1.55; cursor: pointer; }
    .form-consent label a { color: #1a1a18; text-decoration: underline; }
    .form-consent label a:hover { color: var(--accent, #c8772a); }
</style>

<div class="page-header">
  <h1 class="page-title reveal">Kontakt</h1>
</div>

<section class="contact-section reveal">
  <p class="contact-heading">Projektidee?<br>Kontaktiere uns.</p>

  <form id="contact-form">
    <div class="radio-group">
      <label class="radio-label">
        <input type="radio" name="customer_type" value="Privatkunde" checked />
        Privatkunde
      </label>
      <label class="radio-label">
        <input type="radio" name="customer_type" value="Gewerblicher Kunde" />
        Gewerblicher Kunde
      </label>
    </div>

    <div class="form-grid">
      <div class="form-field">
        <label class="form-label">Vorname</label>
        <input type="text" name="vorname" class="form-input" required />
      </div>
      <div class="form-field">
        <label class="form-label">Nachname</label>
        <input type="text" name="nachname" class="form-input" required />
      </div>
      <div class="form-field full">
        <label class="form-label">E-Mail</label>
        <input type="email" name="email" class="form-input" required />
      </div>
      <div class="form-field">
        <label class="form-label">Telefonnummer</label>
        <input type="tel" name="telefon" class="form-input" />
      </div>
      <div class="form-field">
        <label class="form-label">Anschrift</label>
        <input type="text" name="anschrift" class="form-input" />
      </div>
      <div class="form-field">
        <label class="form-label">Gewünschter Einbautermin</label>
        <input type="text" name="einbautermin" class="form-input" />
      </div>
      <div class="form-field">
        <label class="form-label">Kategorie</label>
        <select name="kategorie" class="form-select">
          <option value="">Auswählen...</option>
          <option>Einbauschrank</option>
          <option>Küche</option>
          <option>Wandverkleidung</option>
          <option>Möbel nach Maß</option>
          <option>Innenausbau</option>
          <option>Sonstiges</option>
        </select>
      </div>
      <div class="form-field full" style="margin-top:8px;">
        <label class="form-label">Nachricht</label>
        <textarea name="nachricht" class="form-textarea" rows="4"></textarea>
      </div>
    </div>

    <!-- Honeypot: Bots füllen dieses Feld aus, Menschen nicht -->
    <div class="form-hp" aria-hidden="true">
      <label>Website leer lassen<input type="text" name="hp_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="form-consent">
      <input type="checkbox" id="consent" name="consent" required />
      <label for="consent">
        Ich stimme zu, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert und verwendet werden.
        Weitere Informationen findest du in unserer <a href="/pages/datenschutz">Datenschutzerklärung</a>.
      </label>
    </div>

    <div id="form-status" style="display:none; margin-top:16px; padding:12px 16px; border-radius:6px; font-size:15px;"></div>
    <button type="submit" class="btn-orange" style="margin-top:16px;">Abschicken &nbsp;→</button>
  </form>
</section>
